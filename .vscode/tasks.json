{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (cl)",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Professional\\VC\\Auxiliary\\Build\\vcvars64.bat\" && if not exist \"${fileDirname}\\..\\build\" mkdir \"${fileDirname}\\..\\build\" && cl.exe /EHsc /Zi /Fe:\"${fileDirname}\\..\\build\\app.exe\" /Fo\"${fileDirname}\\..\\build\\\\\" \"${fileDirname}\\*.cpp\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$msCompile",
            "detail": "Build all .cpp files in the active project's src folder, output to <project>/build/app.exe"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}